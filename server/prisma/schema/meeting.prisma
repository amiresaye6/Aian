model Meeting {
  id           String   @id
  connectionId String
  topic        String
  joinUrl      String
  startUrl     String
  startTime    DateTime
  duration     Int

  registrants MeetingRegistrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingRegistrant {
  id String @id @default(cuid())

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  connectionId String
  email        String

  @@unique([meetingId, email])
}
