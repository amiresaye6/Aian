model SubscriptionPlan {
  id String @id @default(uuid())

  name String @db.VarChar(100)
  slug String @unique @db.VarChar(50)

  description String?

  monthlyPriceCents Int @map("monthly_price_cents")
  yearlyPriceCents  Int @map("yearly_price_cents")

  currency String @default("USD") @db.VarChar(10)

  maxMembers Int @map("max_members")

  storageLimitMb Int @map("storage_limit_mb")

  aiTokenLimit             BigInt @default(0) @map("ai_token_limit")
  overageTokenPriceCents   Int    @default(0) @map("overage_token_price_cents")
  overageStoragePriceCents Int    @default(0) @map("overage_storage_price_cents")
  overageUserPriceCents    Int    @default(0) @map("overage_user_price_cents")

  isTrial Boolean @default(false) @map("is_trial")

  active Boolean @default(true)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model UsagePeriodSnapshot {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  periodStart       DateTime @map("period_start") @db.Timestamptz
  periodEnd         DateTime @map("period_end") @db.Timestamptz
  totalTokensUsed   BigInt   @map("total_tokens_used")
  totalStorageMb    Int      @map("total_storage_mb")
  totalMembers      Int      @map("total_members")
  overageTokens     BigInt   @default(0) @map("overage_tokens")
  overageStorageMb  Int      @default(0) @map("overage_storage_mb")
  overageUsers      Int      @default(0) @map("overage_users")
  overageTotalCents Int      @default(0) @map("overage_total_cents")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, periodStart])
  @@map("usage_period_snapshots")
}

model Subscription {
  id String @id @default(uuid())

  organizationId String @unique @map("organization_id")

  planId String @map("plan_id")

  billingCycle BillingCycle @map("billing_cycle")

  status SubscriptionStatus

  paymentProvider String @map("payment_provider") @db.VarChar(50)

  providerCustomerId String? @map("provider_customer_id") @db.VarChar(255)

  providerSubscriptionId String? @unique @map("provider_subscription_id") @db.VarChar(255)

  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz

  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz

  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")

  overageHardCapCents    Int?      @map("overage_hard_cap_cents")
  pendingDowngradePlanId String?   @map("pending_downgrade_plan_id")
  gracePeriodEnd         DateTime? @map("grace_period_end") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  payments Payment[]

  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  subscriptionId    String?       @map("subscription_id")
  paymentProvider   String        @map("payment_provider") @db.VarChar(50)
  providerPaymentId String        @unique @map("provider_payment_id") @db.VarChar(255)
  amountCents       Int           @map("amount_cents")
  currency          String        @db.VarChar(10)
  billingCycle      BillingCycle  @map("billing_cycle")
  status            PaymentStatus
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  failureReason     String?       @map("failure_reason") @db.Text
  providerPayload   Json?         @map("provider_payload")
  invoiceId         String?       @map("invoice_id") @db.VarChar(255)
  type              PaymentType   @default(subscription)
  metadata          Json?         @default("{}")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model AiUsageLog {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  feature        String @db.VarChar(100)
  modelUsed      String @map("model_used") @db.VarChar(100)

  inputTokens  Int   @map("input_tokens")
  outputTokens Int   @map("output_tokens")
  totalTokens  Int   @map("total_tokens")
  costUsd      Float @map("cost_usd")

  stopReason  String? @map("stop_reason") @db.VarChar(50)
  budgetState String? @map("budget_state") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("ai_usage_logs")
}

model LedgerEvent {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  type           LedgerEventType
  oldPlanId      String?         @map("old_plan_id")
  newPlanId      String?         @map("new_plan_id")
  amountCents    Int?            @map("amount_cents")
  currency       String?         @db.VarChar(10)
  description    String?         @db.Text
  metadata       Json?           @default("{}")
  triggeredBy    String?         @map("triggered_by") @db.VarChar(255)
  paymentId      String?         @map("payment_id") @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@map("ledger_events")
}
